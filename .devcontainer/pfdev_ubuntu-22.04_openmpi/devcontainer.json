{
    "name": "pfdev_ubuntu-22.04_openmpi",
    "build": { "dockerfile": "Dockerfile" },
    "customizations": {
        "vscode": {
            "settings": {
                "terminal.integrated.defaultProfile.linux": "bash",
                "terminal.integrated.profiles.linux": {
                    "bash": {
                        "path": "bash",
                        "args": ["-l"]
                    }
                }
            }
        }
    },
	"workspaceMount": "source=${localWorkspaceFolder},target=/home/pfdev/parflow,type=bind,consistency=cached",
	"workspaceFolder": "/home/pfdev"
}
